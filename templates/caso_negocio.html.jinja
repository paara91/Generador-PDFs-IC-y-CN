<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 18mm 16mm 14mm 16mm; }
  body { font-family: 'DejaVu Sans', Arial, sans-serif; color: #222; margin: 0; }
  h1.doc-title {
    text-align: center; font-size: {{ title_font_size }}pt; font-weight: 800; color: #111;
    white-space: nowrap; margin: 0 0 6mm;
  }
  .section-title {
    background: #7391C6; color: #fff; font-weight: 700; font-size: 9.5pt;
    padding: 2mm 3mm; margin: 5mm 0 0;
  }
  table.doc-table {
    width: 100%; border-collapse: collapse; margin: 0 0 5mm;
    border: 0.4pt solid #edf1f6; table-layout: fixed;
  }
  table.doc-table td { border: 0.4pt solid #edf1f6; padding: 2.6mm 3mm; font-size: 10pt; word-wrap: break-word; }
  tr.head-bar td { background: #7391C6; color: #fff; font-weight: 700; text-align: center; font-size: 9.5pt; border-color: #87a3d0; }
  tr.head-val td { text-align: center; font-weight: 700; }
  td.label { background: #A0B4DE; color: #fff; font-weight: 700; width: 34%; }
  .footer { text-align: center; font-size: 8pt; color: #9aa5b5; margin-top: 4mm; }
</style>
</head>
<body>
  <h1 class="doc-title">CASO DE NEGOCIO {{ nombre_proyecto }}</h1>

  <table class="doc-table">
    <tr class="head-bar">
      <td style="width:38%">NOMBRE DEL PROYECTO</td>
      <td style="width:32%">LÍDER DEL PROYECTO</td>
      <td style="width:30%">UEN</td>
    </tr>
    <tr class="head-val">
      <td>{{ nombre_proyecto }}</td>
      <td>{{ lider_proyecto }}</td>
      <td>{{ uen_pill|safe }}</td>
    </tr>
  </table>

  <div class="section-title">DESCRIPCIÓN Y PLANEACIÓN</div>
  <table class="doc-table">
    <tr><td class="label">Descripción del proyecto</td><td>{{ descripcion_proyecto }}</td></tr>
    <tr><td class="label">Fecha de creación</td><td>{{ fecha_creacion }}</td></tr>
    <tr><td class="label">Tipo de proyecto / Categoría</td><td>{{ tipo_proyecto_categoria }}</td></tr>
    <tr><td class="label">Fecha estimada de lanzamiento</td><td>{{ fecha_estimada_lanzamiento }}</td></tr>
  </table>

  <div class="section-title">CONCEPTO</div>
  <table class="doc-table">
    <tr><td>{{ concepto }}</td></tr>
  </table>

  <div class="section-title">MARCA Y MERCADO</div>
  <table class="doc-table">
    <tr><td class="label">Marca</td><td>{{ marca }}</td></tr>
    <tr><td class="label">Sabores</td><td>{{ sabores }}</td></tr>
    <tr><td class="label">Canales</td><td>{{ canales }}</td></tr>
    <tr><td class="label">Regiones</td><td>{{ regiones }}</td></tr>
    <tr><td class="label">Estado de registro de marca y clase</td><td>{{ estado_registro_marca_clase }}</td></tr>
    <tr><td class="label">¿Lanzamiento es In &amp; Out?</td><td>{{ lanzamiento_in_out }}</td></tr>
  </table>

  <div class="section-title">INVERSIONES</div>
  <table class="doc-table">
    <tr><td class="label">Inversiones en marketing</td><td>{{ inversiones_marketing }}</td></tr>
    <tr><td class="label">Inversiones en CAPEX</td><td>{{ inversiones_capex }}</td></tr>
  </table>

  <div class="section-title">PRODUCTO</div>
  <table class="doc-table">
    <tr><td class="label">Características de la fórmula y requerimientos</td><td>{{ caracteristicas_formula }}</td></tr>
    <tr><td class="label">Características del empaque y requerimientos</td><td>{{ caracteristicas_empaque }}</td></tr>
    <tr><td class="label">Vida útil</td><td>{{ vida_util }}</td></tr>
    <tr><td class="label">Centro de producción</td><td>{{ centro_produccion }}</td></tr>
    <tr><td class="label">Resultados de prueba industrial y de transporte</td><td>{{ resultados_prueba_industrial_transporte }}</td></tr>
  </table>

  <div class="section-title">RIESGOS Y PLAN DE ACCIÓN</div>
  <table class="doc-table">
    <tr><td class="label">Posibles tipos de riesgos a presentarse</td><td>{{ posibles_riesgos }}</td></tr>
    <tr><td class="label">Planes de acción</td><td>{{ planes_accion }}</td></tr>
  </table>

  <div class="section-title">VOLÚMENES Y RENTABILIDAD</div>
  <table class="doc-table">
    <tr><td class="label">Volúmenes de la iniciativa</td><td>{{ volumenes_iniciativa }}</td></tr>
    <tr><td class="label">% EBITDA de la iniciativa</td><td>{{ ebitda_iniciativa }}</td></tr>
  </table>

  <div class="section-title">OBSERVACIONES GENERALES</div>
  <table class="doc-table">
    <tr><td>{{ observaciones_generales }}</td></tr>
  </table>

  <div class="footer">Caso de Negocio · Proyecto {{ nombre_proyecto }} · Confidencial</div>
</body>
</html>
